# AVEN-ETH backend configuration
# Copy this file to .env if you want to override any defaults.
# The app runs perfectly with no .env file at all — these are optional.

# Port the Express API listens on.
PORT=4000

# Secret used to sign JWT session tokens. A safe prototype default is
# used if this is not set. Change it if you ever deploy this beyond a
# local demo.
JWT_SECRET=aven-eth-prototype-secret-do-not-use-in-prod
