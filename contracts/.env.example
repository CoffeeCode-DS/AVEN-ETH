# ==============================================================================
# AVEN-ETH Protocol — Smart Contracts Environment Configuration (Track 2)
# ==============================================================================

# 1. Base Sepolia RPC URL (Default free public RPC works out of the box)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# 2. Deployer Private Key (from MetaMask / dev wallet with Base Sepolia testnet ETH)
# WARNING: Use a testnet-only burner wallet! Do NOT use your mainnet funds wallet.
PRIVATE_KEY=

# 3. Basescan API Key (Get a free key from https://basescan.org/myapikey)
# Required to automatically verify Solidity code on Basescan with a green checkmark
BASESCAN_API_KEY=
